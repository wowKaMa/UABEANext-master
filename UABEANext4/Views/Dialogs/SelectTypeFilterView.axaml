<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dlg="using:UABEANext4.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="500"
             x:Class="UABEANext4.Views.Dialogs.SelectTypeFilterView"
             x:DataType="dlg:SelectTypeFilterViewModel">
  <Grid Margin="10,10,10,10" RowDefinitions="*,50">
    <ListBox Grid.Row="0" ItemsSource="{Binding FilterTypes}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <CheckBox IsChecked="{Binding IsSelected}">
              <TextBlock Text="{Binding DisplayText}"/>
            </CheckBox>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="1" VerticalAlignment="Bottom"
          ColumnDefinitions="*,*" RowDefinitions="*,*">
      <Button Grid.Column="0" Grid.Row="0" Command="{Binding SelectAll}">全选 (Select all)</Button>
      <Button Grid.Column="1" Grid.Row="0" Command="{Binding DeselectAll}">取消全选 (Deselect all)</Button>
      <Button Grid.Column="0" Grid.Row="1" Command="{Binding Accept}">确定 (Ok)</Button>
      <Button Grid.Column="1" Grid.Row="1" Command="{Binding Cancel}">取消 (Cancel)</Button>
    </Grid>
  </Grid>
</UserControl>
<!-- <UserControl xmlns="https://github.com/avaloniaui" -->
<!-- 声明 UserControl 根节点并指定 Avalonia 的默认 XAML 命名空间。 -->

<!-- xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" -->
<!-- 引入 x: 命名空间，提供 x:Class、x:Name、x:DataType 等 XAML 语言功能。 -->

<!-- xmlns:d="http://schemas.microsoft.com/expression/blend/2008" -->
<!-- 引入设计时命名空间，仅在设计器（如 Visual Studio / Blend）中使用。 -->

<!-- xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" -->
<!-- 引入兼容性命名空间，用于处理设计时或不同 XAML 版本的兼容性。 -->

<!-- xmlns:dlg="using:UABEANext4.ViewModels.Dialogs" -->
<!-- 在 XAML 中引用 ViewModels.Dialogs 命名空间，以便使用 SelectTypeFilterViewModel 等类型。 -->

<!-- mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="500" -->
<!-- 指示解析器忽略以 d: 前缀开头的属性（设计时属性），并设置设计器中默认宽高（300x500）。 -->

<!-- x:Class="UABEANext4.Views.Dialogs.SelectTypeFilterView" -->
<!-- 指定此 XAML 对应的后台 C# 部分类（partial class），用于代码隐藏文件关联。 -->

<!-- x:DataType="dlg:SelectTypeFilterViewModel"> -->
<!-- 指定此视图的数据上下文类型为 SelectTypeFilterViewModel，以便编译时绑定检查和 IntelliSense。 -->

<!-- <Grid Margin="10,10,10,10" RowDefinitions="*,50"> -->
<!-- 根布局：一个 Grid，外边距为 10 像素（四边）；行定义为两行，第一行填充，第二行高度 50。 -->

<!-- <ListBox Grid.Row="0" ItemsSource="{Binding FilterTypes}"> -->
<!-- 第一行：ListBox，ItemsSource 绑定到 ViewModel 的 FilterTypes（类型过滤项集合）。 -->

<!-- <ListBox.ItemTemplate> -->
<!-- 开始定义 ListBox 的项模板。 -->

<!-- <DataTemplate> -->
<!-- 数据模板开始（每个 FilterTypes 项使用此模板）。 -->

<!-- <StackPanel Orientation="Horizontal"> -->
<!-- 使用水平 StackPanel 布局每一项的内容。 -->

<!-- <CheckBox IsChecked="{Binding IsSelected}"> -->
<!-- 复选框：IsChecked 绑定到项的 IsSelected 属性（表示是否选中）。 -->

<!-- <TextBlock Text="{Binding DisplayText}"/> -->
<!-- 在复选框内部显示文本，Text 绑定到项的 DisplayText（显示名称）。 -->

<!-- </CheckBox> -->
<!-- 结束复选框定义。 -->

<!-- </StackPanel> -->
<!-- 结束 StackPanel。 -->

<!-- </DataTemplate> -->
<!-- 结束数据模板。 -->

<!-- </ListBox.ItemTemplate> -->
<!-- 结束 ListBox 的项模板定义。 -->

<!-- </ListBox> -->
<!-- 结束 ListBox 控件。 -->

<!-- <Grid Grid.Row="1" VerticalAlignment="Bottom" -->
<!-- 第二行：底部 Grid，垂直对齐到底部，包含按钮。 -->

<!-- ColumnDefinitions="*,*" RowDefinitions="*,*"> -->
<!-- 底部 Grid 定义两列两行，列均等分，行均等分。 -->

<!-- <Button Grid.Column="0" Grid.Row="0" Command="{Binding SelectAll}">全选 (Select all)</Button> -->
<!-- 左上按钮：绑定 SelectAll 命令，显示“全选 (Select all)”。 -->

<!-- <Button Grid.Column="1" Grid.Row="0" Command="{Binding DeselectAll}">取消全选 (Deselect all)</Button> -->
<!-- 右上按钮：绑定 DeselectAll 命令，显示“取消全选 (Deselect all)”。 -->

<!-- <Button Grid.Column="0" Grid.Row="1" Command="{Binding Accept}">确定 (Ok)</Button> -->
<!-- 左下按钮：绑定 Accept 命令，显示“确定 (Ok)”。 -->

<!-- <Button Grid.Column="1" Grid.Row="1" Command="{Binding Cancel}">取消 (Cancel)</Button> -->
<!-- 右下按钮：绑定 Cancel 命令，显示“取消 (Cancel)”。 -->

<!-- </Grid> -->
<!-- 结束底部 Grid。 -->

<!-- </Grid> -->
<!-- 结束根 Grid 布局容器。 -->

<!-- </UserControl> -->
<!-- 结束 UserControl 根节点。 -->
