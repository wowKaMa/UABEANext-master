<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dlg="using:UABEANext4.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="UABEANext4.Views.Dialogs.SelectExpParamsView"
             x:DataType="dlg:SelectExpParamsViewModel">
    <Grid Margin="10" RowDefinitions="*, Auto">
        <ListBox Grid.Row="0" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" Padding="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Panel DoubleTapped="OnItemDoubleTapped" Background="Transparent" Height="30">
                        <TextBlock Text="{Binding EditableName}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}" Padding="2"/>
                        <TextBox Text="{Binding EditableName}" BorderThickness="1" VerticalAlignment="Center" 
                                 IsVisible="{Binding IsEditing}" 
                                 KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus"
                                 Classes="inlineEdit"/>
                    </Panel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" IsVisible="{Binding ShowManagementButtons}">
                <Button Command="{Binding AddMenuCommand}">添加菜单 (Add Menu)</Button>
                <Button Command="{Binding DeleteMenuCommand}" Foreground="Red">删除 (Delete)</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Command="{Binding ConfirmCommand}">确定 (Ok)</Button>
                <Button Command="{Binding CancelCommand}">取消 (Cancel)</Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
