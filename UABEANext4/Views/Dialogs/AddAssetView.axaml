<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dlg="using:UABEANext4.ViewModels.Dialogs"
             xmlns:uac="using:UABEANext4.Converters"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="170"
             x:Class="UABEANext4.Views.Dialogs.AddAssetView"
             x:DataType="dlg:AddAssetViewModel">
  <Grid Margin="10,10,10,10">
    <Grid.Resources>
      <uac:AssetsFileInstanceNameConverter x:Key="AssetsFileInstanceNameConverter" />
    </Grid.Resources>
    <Grid VerticalAlignment="Top"
          ColumnDefinitions="170, *"
          RowDefinitions="Auto, Auto, Auto, Auto">
      <Label Grid.Column="0" Grid.Row="0">文件 (File)</Label>
      <ComboBox Grid.Column="1" Grid.Row="0"
                ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                DisplayMemberBinding="{Binding Path=., Converter={StaticResource AssetsFileInstanceNameConverter}}" />
      <Label Grid.Column="0" Grid.Row="1">路径 ID (Path ID)</Label>
      <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding PathIdString}" />
      <Label Grid.Column="0" Grid.Row="2">类型 名称/ID (Type name/ID)</Label>
      <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding TypeNameOrId}" />
      <Label Grid.Column="0" Grid.Row="3">脚本 (Script)</Label>
      <ComboBox Grid.Column="1" Grid.Row="3"
                IsEnabled="{Binding IsScript}" ItemsSource="{Binding Scripts}"
                SelectedIndex="{Binding SelectedScriptIndex}" />
    </Grid>
    <Grid VerticalAlignment="Bottom">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"></ColumnDefinition>
        <ColumnDefinition Width="*"></ColumnDefinition>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Command="{Binding BtnOk_Click}">确定 (Ok)</Button>
      <Button Grid.Column="1" Command="{Binding BtnCancel_Click}">取消 (Cancel)</Button>
    </Grid>
  </Grid>
</UserControl>
<!-- <UserControl xmlns="https://github.com/avaloniaui" -->
<!-- 声明 UserControl 根节点并指定 Avalonia 的默认 XAML 命名空间。 -->

<!-- xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" -->
<!-- 引入 x: 命名空间，提供 x:Class、x:Name 等 XAML 语言功能。 -->

<!-- xmlns:d="http://schemas.microsoft.com/expression/blend/2008" -->
<!-- 引入设计时命名空间，仅在设计器（如 Visual Studio / Blend）中使用。 -->

<!-- xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" -->
<!-- 引入兼容性命名空间，用于处理设计时或不同 XAML 版本的兼容性。 -->

<!-- xmlns:dlg="using:UABEANext4.ViewModels.Dialogs" -->
<!-- 在 XAML 中引用 ViewModels.Dialogs 命名空间，以便使用 AddAssetViewModel 等类型。 -->

<!-- xmlns:uac="using:UABEANext4.Converters" -->
<!-- 在 XAML 中引用 Converters 命名空间，以便使用 AssetsFileInstanceNameConverter 等转换器。 -->

<!-- mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="170" -->
<!-- 指示解析器忽略以 d: 前缀开头的属性（设计时属性），并设置设计器中默认宽高（300x170）。 -->

<!-- x:Class="UABEANext4.Views.Dialogs.AddAssetView" -->
<!-- 指定此 XAML 对应的后台 C# 部分类（partial class），用于代码隐藏文件关联。 -->

<!-- x:DataType="dlg:AddAssetViewModel"> -->
<!-- 指定此视图的数据上下文类型为 AddAssetViewModel，以便编译时绑定检查和 IntelliSense。 -->

<!-- <Grid Margin="10,10,10,10"> -->
<!-- 根布局：一个 Grid，外边距为 10 像素（四边）。 -->

<!-- <Grid.Resources> -->
<!-- 开始定义此 Grid 的资源集合（局部资源）。 -->

<!-- <uac:AssetsFileInstanceNameConverter x:Key="AssetsFileInstanceNameConverter" /> -->
<!-- 注册 AssetsFileInstanceNameConverter 为资源，键名为 AssetsFileInstanceNameConverter，用于将文件实例对象转换为显示名称。 -->

<!-- </Grid.Resources> -->
<!-- 结束资源集合定义。 -->

<!-- <Grid VerticalAlignment="Top" -->
<!-- 内部 Grid：垂直对齐到顶部，下面定义列与行。 -->

<!-- ColumnDefinitions="100, *" -->
<!-- 列定义：第一列宽度 100，第二列占剩余空间。 -->

<!-- RowDefinitions="Auto, Auto, Auto, Auto"> -->
<!-- 行定义：四行均为 Auto（根据内容高度自适应）。 -->

<!-- <Label Grid.Column="0" Grid.Row="0">文件 (File)</Label> -->
<!-- 第一行第一列的标签，显示“文件 (File)”（中文 + 英文原名）。 -->

<!-- <ComboBox Grid.Column="1" Grid.Row="0" -->
<!-- 第一行第二列的下拉框： -->

<!-- ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" -->
<!-- ItemsSource 绑定到 ViewModel 的 Files 集合；SelectedItem 绑定到 SelectedFile。 -->

<!-- DisplayMemberBinding="{Binding Path=., Converter={StaticResource AssetsFileInstanceNameConverter}}" /> -->
<!-- DisplayMemberBinding 使用转换器将每个文件实例转换为显示文本（使用注册的资源）。 -->

<!-- <Label Grid.Column="0" Grid.Row="1">路径 ID (Path ID)</Label> -->
<!-- 第二行第一列的标签，显示“路径 ID (Path ID)”。 -->

<!-- <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding PathIdString}" /> -->
<!-- 第二行第二列的文本框，Text 绑定到 ViewModel 的 PathIdString（用于输入/显示 Path ID）。 -->

<!-- <Label Grid.Column="0" Grid.Row="2">类型 名称/ID (Type name/ID)</Label> -->
<!-- 第三行第一列的标签，显示“类型 名称/ID (Type name/ID)”。 -->

<!-- <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding TypeNameOrId}" /> -->
<!-- 第三行第二列的文本框，Text 绑定到 ViewModel 的 TypeNameOrId（用于输入类型名称或 ID）。 -->

<!-- <Label Grid.Column="0" Grid.Row="3">脚本 (Script)</Label> -->
<!-- 第四行第一列的标签，显示“脚本 (Script)”。 -->

<!-- <ComboBox Grid.Column="1" Grid.Row="3" -->
<!-- 第四行第二列的下拉框： -->

<!-- IsEnabled="{Binding IsScript}" ItemsSource="{Binding Scripts}" -->
<!-- IsEnabled 绑定到 ViewModel 的 IsScript（控制是否可用）；ItemsSource 绑定到 Scripts 集合。 -->

<!-- SelectedIndex="{Binding SelectedScriptIndex}" /> -->
<!-- SelectedIndex 绑定到 SelectedScriptIndex（选择的脚本索引）。 -->

<!-- </Grid> -->
<!-- 结束顶部 Grid（包含标签、输入控件）。 -->

<!-- <Grid VerticalAlignment="Bottom"> -->
<!-- 底部 Grid：垂直对齐到底部，用于放置操作按钮。 -->

<!-- <Grid.ColumnDefinitions> -->
<!-- 开始定义底部 Grid 的列。 -->

<!-- <ColumnDefinition Width="*"></ColumnDefinition> -->
<!-- 第一列占剩余空间（用于左侧按钮）。 -->

<!-- <ColumnDefinition Width="*"></ColumnDefinition> -->
<!-- 第二列占剩余空间（用于右侧按钮）。 -->

<!-- </Grid.ColumnDefinitions> -->
<!-- 结束列定义。 -->

<!-- <Button Grid.Column="0" Command="{Binding BtnOk_Click}">确定 (Ok)</Button> -->
<!-- 左侧按钮：绑定 BtnOk_Click 命令，显示“确定 (Ok)”。 -->

<!-- <Button Grid.Column="1" Command="{Binding BtnCancel_Click}">取消 (Cancel)</Button> -->
<!-- 右侧按钮：绑定 BtnCancel_Click 命令，显示“取消 (Cancel)”。 -->

<!-- </Grid> -->
<!-- 结束底部 Grid。 -->

<!-- </Grid> -->
<!-- 结束根 Grid 布局容器。 -->

<!-- </UserControl> -->
<!-- 结束 UserControl 根节点。 -->
