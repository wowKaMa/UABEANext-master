<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UABEANext4.ViewModels.Tools"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
        x:Class="UABEANext4.Views.Tools.OscToolWindow"
        x:CompileBindings="False"
        Title="Shell Protector OSC (移植版/Port)"
        Width="450" Height="700"
        CanResize="True"
        MinWidth="400" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">

    <Design.DataContext>
        <vm:OscToolViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *" Margin="15">
        
        <!-- Header -->
        <TextBlock Text="Shell Protector OSC" Foreground="#00FF00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1" RowDefinitions="*, 200">
            <!-- Top Part: Scrollable Inputs and Controls -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel Spacing="10">
                    <Separator Height="1" Background="#444444" Margin="0,0,0,10"/>

                    <!-- Password & Key Index -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="密码 (Password)" VerticalAlignment="Center" Foreground="#cccccc" Width="100"/>
                        <TextBox Text="{Binding Password}" Width="150" Watermark="请输入密码 (Enter Password)"/>
                        <ComboBox ItemsSource="{Binding KeyLengths}" SelectedIndex="{Binding KeyIndex}" Width="60" />
                    </StackPanel>

                    <!-- Port -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="OSC 端口 (Port)" VerticalAlignment="Center" Foreground="#cccccc" Width="100"/>
                        <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" Width="100" FormatString="0"/>
                    </StackPanel>

                    <Separator Height="1" Background="#444444" Margin="0,5"/>

                    <!-- Multiplexing -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="参数复用 (Multiplexing)" VerticalAlignment="Center" Foreground="#cccccc" Width="150"/>
                        <CheckBox IsChecked="{Binding IsMultiplexing}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsMultiplexing}">
                        <TextBlock Text="刷新频率 (Refresh Rate) (ms)" VerticalAlignment="Center" Foreground="#aaaaaa" Width="180" Margin="20,0,0,0" FontSize="12"/>
                        <NumericUpDown Value="{Binding RefreshRate}" Minimum="1" Maximum="1000" Width="80" FormatString="0"/>
                    </StackPanel>

                    <!-- Save Option -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="保存设置 (Save Settings)" VerticalAlignment="Center" Foreground="#cccccc" Width="150"/>
                        <CheckBox IsChecked="{Binding SaveSettings}" />
                    </StackPanel>
                    
                    <!-- Start Hidden -->
                     <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="启动时隐藏 (Start Hidden)" VerticalAlignment="Center" Foreground="#cccccc" Width="150"/>
                        <CheckBox IsChecked="{Binding StartHidden}" />
                    </StackPanel>

                    <Separator Height="1" Background="#444444" Margin="0,5"/>

                    <!-- Brute Force Section -->
                    <Expander Header="暴力破解 (Brute Force)" IsExpanded="True" Foreground="#dddddd">
                        <StackPanel Spacing="10">
                            <!-- Mode Selection -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="模式 (Mode)" VerticalAlignment="Center" Foreground="#cccccc" Width="80"/>
                                <ComboBox SelectedIndex="{Binding SelectedBruteForceModeIndex}" Width="200">
                                    <ComboBoxItem>模式 A (纯数字 - Numeric)</ComboBoxItem>
                                    <ComboBoxItem>模式 B (模型名 - ModelName)</ComboBoxItem>
                                    <ComboBoxItem>模式 C (日期 - Date)</ComboBoxItem>
                                    <ComboBoxItem>模式 D (字典 - Dictionary)</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <!-- Numeric Mode Inputs -->
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsNumericMode}">
                                <TextBlock Text="最大位数 (Max Digits)" VerticalAlignment="Center" Foreground="#cccccc" Width="120"/>
                                <NumericUpDown Value="{Binding BruteForceMaxDigits}" Minimum="1" Maximum="10" Width="80" FormatString="0"/>
                                <TextBlock Text="(0-9...)" VerticalAlignment="Center" Foreground="#777777" FontSize="10"/>
                            </StackPanel>

                            <!-- Model Name Inputs -->
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsModelNameMode}">
                                <TextBlock Text="模型名 (Model Name)" VerticalAlignment="Center" Foreground="#cccccc" Width="120"/>
                                <TextBox Text="{Binding BruteForceModelName}" Width="120"/>
                                <TextBlock Text="+ 0000" VerticalAlignment="Center" Foreground="#777777" FontSize="10"/>
                            </StackPanel>

                            <!-- Date Inputs -->
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsDateMode}">
                                <TextBlock Text="范围 (Range)" VerticalAlignment="Center" Foreground="#cccccc" Width="120"/>
                                <TextBlock Text="20100101 - 20261231" VerticalAlignment="Center" Foreground="#aaaaaa"/>
                            </StackPanel>

                            <!-- Dictionary Inputs -->
                            <StackPanel Orientation="Vertical" Spacing="5" IsVisible="{Binding IsDictionaryMode}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="字典文件夹 (Folder)" VerticalAlignment="Center" Foreground="#cccccc" Width="120"/>
                                    <Button Command="{Binding SelectDictionaryFolderCommand}" Content="选择 (Select)" Width="60"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DictionaryFolderPath}" Foreground="#999999" FontSize="10" TextWrapping="Wrap" Margin="130,0,0,0"/>
                            </StackPanel>

                            <!-- Brute Force Actions -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
                                 <Button Command="{Binding StartBruteForceCommand}" Content="开始破解 (Start Brute Force)" 
                                         Background="#875d2c" Foreground="White" Width="180" IsVisible="{Binding !IsBruteForcing}"/>
                                 <Button Command="{Binding StopBruteForceCommand}" Content="停止破解 (Stop Brute Force)" 
                                         Background="#872c2c" Foreground="White" Width="180" IsVisible="{Binding IsBruteForcing}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Separator Height="1" Background="#444444" Margin="0,10"/>

                    <!-- Offline Decryption Section -->
                    <Expander Header="离线解密 (Offline Decryption)" IsExpanded="True" Foreground="#dddddd">
                        <StackPanel Spacing="10">
                            <TextBlock Text="源色彩/副贴图 (Source Palette / _Encrypt2):" Foreground="#cccccc"/>
                            <ComboBox ItemsSource="{Binding TextureList}" SelectedItem="{Binding SelectedAsset}" HorizontalAlignment="Stretch" PlaceholderText="请选择资源 (Select Asset)..." MaxDropDownHeight="200">
                                 <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AssetName}" FontWeight="Bold"/>
                                            <TextBlock Text=" (ID: "/>
                                            <TextBlock Text="{Binding PathId}"/>
                                            <TextBlock Text=")"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding SelectedAssetName}" Foreground="#aaaaaa" TextWrapping="Wrap" Margin="10,0,0,0" FontSize="10"/>

                            <TextBlock Text="关联主贴图 (Target Main Texture / _Encrypt):" Foreground="#cccccc" Margin="0,5,0,0"/>
                            <ComboBox ItemsSource="{Binding TextureList}" SelectedItem="{Binding TargetAsset}" HorizontalAlignment="Stretch" PlaceholderText="自动选择或手动指定 (Auto-select or manual)..." MaxDropDownHeight="200">
                                 <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AssetName}" FontWeight="Bold"/>
                                            <TextBlock Text=" (ID: "/>
                                            <TextBlock Text="{Binding PathId}"/>
                                            <TextBlock Text=")"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Spacing="20" Margin="10,2,0,5">
                                <TextBlock Text="{Binding SelectedAssetFormat}" Foreground="#87ceeb" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedAssetChannels}" Foreground="#f08080" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Command="{Binding OfflineDecryptCommand}" Content="解密 (Decrypt)" 
                                        IsEnabled="{Binding CanDecrypt}"
                                        Background="#872c2c" Foreground="White" HorizontalAlignment="Stretch" Width="190" HorizontalContentAlignment="Center"/>
                                <Button Command="{Binding ExportPNGCommand}" Content="导出 PNG (Export PNG)" 
                                        IsEnabled="{Binding CanDecrypt}"
                                        Background="#2c875d" Foreground="White" HorizontalAlignment="Stretch" Width="190" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="加密方式 (Mode)" VerticalAlignment="Center" Foreground="#cccccc" FontSize="11" Width="120"/>
                                <ComboBox ItemsSource="{Binding EncryptionModes}" SelectedIndex="{Binding SelectedEncryptionModeIndex}" Width="230" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsXXTEAMode}">
                                <NumericUpDown Value="{Binding EncryptionRounds}" Minimum="1" Maximum="128" Width="80" FormatString="0" FontSize="11"/>
                                <TextBlock Text="XXTEA 轮数 (Rounds)" VerticalAlignment="Center" Foreground="#cccccc" FontSize="11" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Spacing="5" IsVisible="{Binding IsChaChaMode}">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,5">
                                    <TextBlock Text="材质球 (Material)" VerticalAlignment="Center" Foreground="#cccccc" FontSize="11" Width="120"/>
                                    <ComboBox ItemsSource="{Binding MaterialList}" SelectedItem="{Binding SelectedMaterial}" Width="230" FontSize="11">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AssetName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <NumericUpDown Value="{Binding Nonce0}" Minimum="-2147483648" Maximum="2147483647" Width="120" FormatString="0" FontSize="11"/>
                                    <TextBlock Text="_Nonce0" VerticalAlignment="Center" Foreground="#cccccc" FontSize="11" Width="120"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <NumericUpDown Value="{Binding Nonce1}" Minimum="-2147483648" Maximum="2147483647" Width="120" FormatString="0" FontSize="11"/>
                                    <TextBlock Text="_Nonce1" VerticalAlignment="Center" Foreground="#cccccc" FontSize="11" Width="120"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <NumericUpDown Value="{Binding Nonce2}" Minimum="-2147483648" Maximum="2147483647" Width="120" FormatString="0" FontSize="11"/>
                                    <TextBlock Text="_Nonce2" VerticalAlignment="Center" Foreground="#cccccc" FontSize="11" Width="120"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                 <TextBlock Text="伽马校正 (Gamma)" VerticalAlignment="Center" Foreground="#cccccc" FontSize="11" Width="120"/>
                                 <ComboBox ItemsSource="{Binding GammaModes}" SelectedIndex="{Binding SelectedGammaModeIndex}" Width="230" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="通道顺序 (Channel Order)" VerticalAlignment="Center" Foreground="#cccccc" FontSize="11" Width="120"/>
                                <TextBox Text="{Binding ChannelOrder}" Width="80" FontSize="11" Watermark="RGBA"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Separator Height="1" Background="#444444" Margin="0,10"/>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding StartCommand}" Content="开始 (Start!)" Width="120" 
                                Background="#2c5d87" Foreground="White" IsVisible="{Binding !IsRunning}"/>
                        <Button Command="{Binding StopCommand}" Content="停止 (Stop)" Width="120" 
                                Background="#872c2c" Foreground="White" IsVisible="{Binding IsRunning}"/>
                        <Button Content="隐藏窗口 (Hide Window)" Width="150" IsEnabled="False" ToolTip.Tip="尚未实现 (Not implemented yet)"/>
                    </StackPanel>
                    
                    <Separator Height="1" Background="#444444" Margin="0,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Part: Fillable Logs -->
            <Grid Grid.Row="1" RowDefinitions="Auto, *, Auto" Margin="0,10,0,0">
                <TextBlock Grid.Row="0" Text="日志 (Logs)" FontWeight="Bold" Foreground="#aaaaaa" Margin="0,0,0,5"/>
                <Border Grid.Row="1" BorderBrush="#333333" BorderThickness="1" Background="#252525">
                    <ListBox ItemsSource="{Binding Logs}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#dddddd" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Button Grid.Row="2" Command="{Binding ClearLogsCommand}" Content="清除日志 (Clear Logs)" HorizontalAlignment="Right" FontSize="11" Padding="5,2" Margin="0,5,0,0"/>
            </Grid>
        </Grid>

    </Grid>
</Window>
