<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UABEANext4.ViewModels.Tools"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="UABEANext4.Views.Tools.PasswordCrackerWindow"
        x:CompileBindings="False"
        x:Name="RootWindow"
        Title="状态机分析 (State Machine Analysis)">

    <Design.DataContext>
        <vm:PasswordCrackerViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#2b2b2b" BorderBrush="#111111" BorderThickness="0,0,0,1">
            <MenuItem Header="菜单参数 (Expression Parameters)" Command="{Binding OpenExpParamsCommand}" />
            <MenuItem Header="菜单 (Menu)" Command="{Binding OpenMenuCommand}" />
        </Menu>
        <Grid ColumnDefinitions="280, *, 300">
        <!-- Sidebar (Unity Style) -->
        <Border Grid.Column="0" Background="#383838" BorderBrush="#111111" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *">
                <!-- Controller Selector (Styled as Unity Project Header) -->
                <Border Background="#444444" Padding="8,10" BorderBrush="#222222" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="5">
                        <TextBlock Text="控制器 (Controllers)" Foreground="#aaaaaa" FontSize="10" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding Controllers}" SelectedItem="{Binding SelectedController}" 
                                  HorizontalAlignment="Stretch" Background="#282828" BorderThickness="1" BorderBrush="#1a1a1a">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <TextBlock Text="{Binding Name}" FontSize="11" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Tabs (Layers / Parameters) -->
                <TabControl Grid.Row="1" IsVisible="{Binding IsControllerSelected}">
                    <TabControl.Styles>
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Width" Value="110"/>
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Background" Value="#3c3c3c"/>
                            <Setter Property="Foreground" Value="#aaaaaa"/>
                        </Style>
                        <Style Selector="TabItem:pointerover">
                            <Setter Property="Background" Value="#444444"/>
                        </Style>
                        <Style Selector="TabItem:selected">
                            <Setter Property="Background" Value="#383838"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </TabControl.Styles>

                    <!-- Layers Tab -->
                    <TabItem Header="图层 (Layers)">
                        <Grid RowDefinitions="Auto, *">
                            <Border Grid.Row="0" Background="#3c3c3c" BorderBrush="#222222" BorderThickness="0,0,0,1" Height="25">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+" Command="{Binding AddLayerCommand}" Background="Transparent" BorderThickness="0" 
                                            Foreground="#aaaaaa" Padding="10,0" VerticalAlignment="Center" FontSize="14"/>
                                    <Button Content="-" Command="{Binding RemoveLayerCommand}" Background="Transparent" BorderThickness="0" 
                                            Foreground="#aaaaaa" Padding="10,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Border>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" 
                                     Background="Transparent" BorderThickness="0" Padding="0">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#2d2d2d"/>
                                        <Setter Property="Background" Value="#3c3c3c"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="#2c5d87"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" Height="30" Margin="10,0">
                                                <TextBlock Text="≡" Foreground="#555555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="11" Foreground="#cccccc"
                                                         Background="Transparent" BorderThickness="0" Padding="0" Margin="0"/>
                                                
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="#aaaaaa" Margin="5,0"/>
                                                
                                                <TextBlock Grid.Column="3" Text="👁" Foreground="#555555" Margin="5,0" VerticalAlignment="Center" FontSize="10"/>
                                                <!-- 齿轮图标按钮 (Gear Icon Button) -->
                                                <Button Grid.Column="4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="0" Width="20" Height="20">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </Style>
                                                </Button.Styles>
                                                <TextBlock Text="⚙" Foreground="#888888" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedRight">
                                                        <Border Width="260" Background="#3c3c3c" BorderBrush="#1a1a1a" BorderThickness="1" CornerRadius="3" Padding="12">
                                                            <StackPanel Spacing="10">
                                                                <TextBlock Text="图层设置 (Layer Settings)" FontWeight="Bold" Foreground="#aaaaaa" FontSize="10" Margin="0,0,0,5"/>
                                                                
                                                                <!-- Weight -->
                                                                <Grid ColumnDefinitions="90, *, 40">
                                                                    <TextBlock Text="权重 (Weight)" VerticalAlignment="Center" FontSize="11" Foreground="#cccccc"/>
                                                                    <Slider Grid.Column="1" Value="{Binding Weight}" Minimum="0" Maximum="1" Margin="8,0"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Weight, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Foreground="#55aaff"/>
                                                                </Grid>
                                                                
                                                                <!-- Mask -->
                                                                <Grid ColumnDefinitions="90, *">
                                                                    <TextBlock Text="遮罩 (Mask)" VerticalAlignment="Center" FontSize="11" Foreground="#cccccc"/>
                                                                    <Border Grid.Column="1" Background="#282828" BorderBrush="#1a1a1a" BorderThickness="1" Height="24" CornerRadius="2">
                                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                                            <TextBlock Text="👤" Margin="5,0" VerticalAlignment="Center" FontSize="10" Foreground="#55aaff"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding MaskName}" VerticalAlignment="Center" FontSize="10" Foreground="#cccccc" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Grid.Column="2" Text="⊙" Margin="5,0" VerticalAlignment="Center" FontSize="10" Foreground="#555555"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>

                                                                <!-- Body Mask Editor -->
                                                                <Border Background="#2a2a2a" CornerRadius="4" Padding="8" Margin="0,5">
                                                                    <Grid RowDefinitions="Auto, *">
                                                                        <TextBlock Text="身体遮罩 (Body Mask)" FontSize="10" Foreground="#888888" Margin="0,0,0,5"/>
                                                                        <Canvas Grid.Row="1" Width="200" Height="300" Background="#333333" HorizontalAlignment="Center">
                                                                            <!-- Head -->
                                                                            <Button Canvas.Left="80" Canvas.Top="5" Width="40" Height="35" 
                                                                                    Command="{Binding BodyParts[1].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <Ellipse Width="30" Height="30" Fill="{Binding BodyParts[1].FillColor}" Opacity="0.7" Stroke="#00FF00" StrokeThickness="1"/>
                                                                            </Button>
                                                                            <!-- Body -->
                                                                            <Button Canvas.Left="70" Canvas.Top="40" Width="60" Height="80"
                                                                                    Command="{Binding BodyParts[3].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <Rectangle Width="50" Height="70" Fill="{Binding BodyParts[3].FillColor}" Opacity="0.7" Stroke="#00FF00" StrokeThickness="1" RadiusX="5" RadiusY="5"/>
                                                                            </Button>
                                                                            <!-- Left Arm -->
                                                                            <Button Canvas.Left="25" Canvas.Top="42" Width="45" Height="50"
                                                                                    Command="{Binding BodyParts[2].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <Rectangle Width="20" Height="45" Fill="{Binding BodyParts[2].FillColor}" Opacity="0.7" Stroke="#00FF00" StrokeThickness="1" RadiusX="3" RadiusY="3"/>
                                                                            </Button>
                                                                            <!-- Right Arm -->
                                                                            <Button Canvas.Left="130" Canvas.Top="42" Width="45" Height="50"
                                                                                    Command="{Binding BodyParts[4].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <Rectangle Width="20" Height="45" Fill="{Binding BodyParts[4].FillColor}" Opacity="0.7" Stroke="#00FF00" StrokeThickness="1" RadiusX="3" RadiusY="3"/>
                                                                            </Button>
                                                                            <!-- Left Hand -->
                                                                            <Button Canvas.Left="25" Canvas.Top="92" Width="30" Height="25"
                                                                                    Command="{Binding BodyParts[5].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <Ellipse Width="18" Height="18" Fill="{Binding BodyParts[5].FillColor}" Opacity="0.7" Stroke="#00FF00" StrokeThickness="1"/>
                                                                            </Button>
                                                                            <!-- Right Hand -->
                                                                            <Button Canvas.Left="145" Canvas.Top="92" Width="30" Height="25"
                                                                                    Command="{Binding BodyParts[6].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <Ellipse Width="18" Height="18" Fill="{Binding BodyParts[6].FillColor}" Opacity="0.7" Stroke="#00FF00" StrokeThickness="1"/>
                                                                            </Button>
                                                                            <!-- Left Hand IK -->
                                                                            <Button Canvas.Left="50" Canvas.Top="105" Width="30" Height="20"
                                                                                    Command="{Binding BodyParts[7].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                                                    <Ellipse Width="10" Height="10" Fill="{Binding BodyParts[7].FillColor}" Opacity="0.9"/>
                                                                                    <TextBlock Text="IK" FontSize="7" Foreground="{Binding BodyParts[7].FillColor}" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <!-- Right Hand IK -->
                                                                            <Button Canvas.Left="120" Canvas.Top="105" Width="30" Height="20"
                                                                                    Command="{Binding BodyParts[8].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                                                    <Ellipse Width="10" Height="10" Fill="{Binding BodyParts[8].FillColor}" Opacity="0.9"/>
                                                                                    <TextBlock Text="IK" FontSize="7" Foreground="{Binding BodyParts[8].FillColor}" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <!-- Left Leg -->
                                                                            <Button Canvas.Left="60" Canvas.Top="125" Width="35" Height="80"
                                                                                    Command="{Binding BodyParts[9].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <Rectangle Width="22" Height="70" Fill="{Binding BodyParts[9].FillColor}" Opacity="0.7" Stroke="#00FF00" StrokeThickness="1" RadiusX="3" RadiusY="3"/>
                                                                            </Button>
                                                                            <!-- Right Leg -->
                                                                            <Button Canvas.Left="105" Canvas.Top="125" Width="35" Height="80"
                                                                                    Command="{Binding BodyParts[10].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <Rectangle Width="22" Height="70" Fill="{Binding BodyParts[10].FillColor}" Opacity="0.7" Stroke="#00FF00" StrokeThickness="1" RadiusX="3" RadiusY="3"/>
                                                                            </Button>
                                                                            <!-- Left Leg IK -->
                                                                            <Button Canvas.Left="40" Canvas.Top="210" Width="30" Height="20"
                                                                                    Command="{Binding BodyParts[11].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                                                    <Ellipse Width="10" Height="10" Fill="{Binding BodyParts[11].FillColor}" Opacity="0.9"/>
                                                                                    <TextBlock Text="IK" FontSize="7" Foreground="{Binding BodyParts[11].FillColor}" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <!-- Root / Pedestal -->
                                                                            <Button Canvas.Left="65" Canvas.Top="230" Width="70" Height="30"
                                                                                    Command="{Binding BodyParts[0].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <Ellipse Width="60" Height="20" Fill="{Binding BodyParts[0].FillColor}" Opacity="0.6" Stroke="#00FF00" StrokeThickness="1"/>
                                                                            </Button>
                                                                            <!-- Right Leg IK -->
                                                                            <Button Canvas.Left="130" Canvas.Top="210" Width="30" Height="20"
                                                                                    Command="{Binding BodyParts[12].ToggleCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                                                    <Ellipse Width="10" Height="10" Fill="{Binding BodyParts[12].FillColor}" Opacity="0.9"/>
                                                                                    <TextBlock Text="IK" FontSize="7" Foreground="{Binding BodyParts[12].FillColor}" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </Canvas>
                                                                    </Grid>
                                                                </Border>

                                                                <Separator Background="#222222" Height="1" Margin="0,5"/>
                                                                
                                                                <!-- Blending -->
                                                                <Grid ColumnDefinitions="90, *">
                                                                    <TextBlock Text="混合 (Blending)" VerticalAlignment="Center" FontSize="11" Foreground="#cccccc"/>
                                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding BlendingModes}"  SelectedIndex="{Binding BlendingMode}"
                                                                              Height="24" FontSize="11" HorizontalAlignment="Stretch" Background="#282828" BorderThickness="1" BorderBrush="#1a1a1a"/>
                                                                </Grid>
                                                                
                                                                <!-- Sync & Timing -->
                                                                <Grid ColumnDefinitions="90, Auto, Auto, Auto">
                                                                    <TextBlock Text="同步 (Sync)" VerticalAlignment="Center" FontSize="11" Foreground="#cccccc"/>
                                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsSynced}" MinWidth="0" Padding="0"/>
                                                                    
                                                                    <TextBlock Grid.Column="2" Text="Timing" Margin="15,0,5,0" VerticalAlignment="Center" FontSize="11" Foreground="#cccccc" 
                                                                               IsVisible="{Binding IsSynced}"/>
                                                                    <CheckBox Grid.Column="3" IsChecked="{Binding SyncedLayerAffectsTiming}" IsEnabled="{Binding IsTimingEnabled}" 
                                                                              MinWidth="0" Padding="0" IsVisible="{Binding IsSynced}"/>
                                                                </Grid>
                                                                
                                                                <!-- Source Layer (Visible when Synced) -->
                                                                <Grid ColumnDefinitions="90, *" IsVisible="{Binding IsSynced}" Margin="0,5,0,0">
                                                                    <TextBlock Text="源图层 (Source Layer)" VerticalAlignment="Center" FontSize="10" Foreground="#cccccc"/>
                                                                    <ComboBox Grid.Column="1" 
                                                                              ItemsSource="{Binding #RootWindow.DataContext.BaseLayers}"
                                                                              SelectedItem="{Binding SyncSource}"
                                                                              Height="24" FontSize="11" HorizontalAlignment="Stretch" Background="#282828" BorderThickness="1" BorderBrush="#1a1a1a">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Name}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </Grid>
                                                                
                                                                <!-- IK Pass -->
                                                                <Grid ColumnDefinitions="90, *">
                                                                    <TextBlock Text="IK 传递 (IK Pass)" VerticalAlignment="Center" FontSize="11" Foreground="#cccccc"/>
                                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IKPass}" MinWidth="0" Padding="0"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- Parameters Tab -->
                    <TabItem Header="参数 (Parameters)">
                         <Grid RowDefinitions="Auto, *">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Height="25">
                                <Button Content="+" Background="Transparent" BorderThickness="0" 
                                        Foreground="#aaaaaa" Padding="10,0" VerticalAlignment="Center" FontSize="14">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="Float" Command="{Binding AddParameterCommand}" CommandParameter="Float" />
                                            <MenuItem Header="Int" Command="{Binding AddParameterCommand}" CommandParameter="Int" />
                                            <MenuItem Header="Bool" Command="{Binding AddParameterCommand}" CommandParameter="Bool" />
                                            <MenuItem Header="Trigger" Command="{Binding AddParameterCommand}" CommandParameter="Trigger" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                 <Button Content="-" Command="{Binding RemoveParameterCommand}" CommandParameter="{Binding SelectedParameter}"
                                         Background="Transparent" BorderThickness="0" Foreground="#aaaaaa" Padding="10,0" VerticalAlignment="Center" FontSize="14"/>
                             </StackPanel>
                             <ListBox Grid.Row="1" Name="ParameterList" ItemsSource="{Binding ParameterItems}" SelectedItem="{Binding SelectedParameter}" Background="Transparent" BorderThickness="0" Padding="0">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#2d2d2d"/>
                                        <Setter Property="Background" Value="#3c3c3c"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <Grid ColumnDefinitions="*, Auto, 60" Height="30" Margin="10,0">
                                             <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Foreground="#cccccc" FontSize="11" 
                                                      Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" Margin="0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="9" Padding="5" VerticalAlignment="Center" Foreground="#666666" />
                                            <Panel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <!-- Numeric (Float/Int) -->
                                                <TextBox Text="{Binding DefaultValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         IsVisible="{Binding IsNumeric}"
                                                          VerticalAlignment="Center" Foreground="#55aaff" FontSize="10" 
                                                          Background="#252525" BorderBrush="#1a1a1a" BorderThickness="1" Padding="4,0" 
                                                          MinWidth="35" TextAlignment="Right" VerticalContentAlignment="Center" Margin="0" />
                                                
                                                <!-- Bool -->
                                                <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" 
                                                          IsVisible="{Binding IsBool}"
                                                          MinWidth="0" Padding="0" VerticalAlignment="Center" 
                                                          BorderBrush="#1a1a1a" Background="#282828" />

                                                <!-- Trigger (Styled as a circular toggle) -->
                                                <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" 
                                                          IsVisible="{Binding IsTrigger}"
                                                          MinWidth="0" Padding="0" VerticalAlignment="Center" 
                                                          BorderBrush="#1a1a1a" Background="#282828">
                                                    <CheckBox.Styles>
                                                        <Style Selector="CheckBox /template/ Border#NormalRectangle">
                                                            <Setter Property="CornerRadius" Value="10" />
                                                            <Setter Property="Width" Value="14" />
                                                            <Setter Property="Height" Value="14" />
                                                        </Style>
                                                        <Style Selector="CheckBox /template/ Path#CheckMark">
                                                            <Setter Property="Data" Value="M 7,7 m -3,0 a 3,3 0 1,0 6,0 a 3,3 0 1,0 -6,0" />
                                                            <Setter Property="Width" Value="8" />
                                                            <Setter Property="Height" Value="8" />
                                                        </Style>
                                                    </CheckBox.Styles>
                                                </CheckBox>
                                            </Panel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
                <TextBlock Grid.Row="1" Text="请选择一个控制器以查看图层 (Please select a controller to view layers)" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="#555555" FontSize="11" TextWrapping="Wrap" Margin="10"
                           IsVisible="{Binding !IsControllerSelected}" />
            </Grid>
        </Border>

        <!-- Graph Area (Unity Style) -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
            <!-- Breadcrumb Header -->
            <Border Grid.Row="0" Background="#444444" Height="25" BorderBrush="#111111" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="👁" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedLayer.Name, FallbackValue='无图层 (No Layer)'}" 
                                   Foreground="#cccccc" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Column="2" Text="实时同步 (Live Sync)" Foreground="#888888" FontSize="10" 
                               VerticalAlignment="Center" Margin="15,0"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Name="GraphScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Background>
                    <!-- Unity Grid Style -->
                    <VisualBrush TileMode="Tile" SourceRect="0,0,40,40" DestinationRect="0,0,40,40">
                        <VisualBrush.Visual>
                            <Canvas Width="40" Height="40" Background="#313131">
                                <Line StartPoint="0,0" EndPoint="40,0" Stroke="#282828" StrokeThickness="1" />
                                <Line StartPoint="0,0" EndPoint="0,40" Stroke="#282828" StrokeThickness="1" />
                                <Line StartPoint="20,0" EndPoint="20,40" Stroke="#383838" StrokeThickness="0.5" />
                                <Line StartPoint="0,20" EndPoint="40,20" Stroke="#383838" StrokeThickness="0.5" />
                            </Canvas>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </ScrollViewer.Background>
                    <Canvas Width="4000" Height="4000" Name="GraphCanvas" Background="Transparent" 
                            PointerPressed="OnCanvasPointerPressed" PointerMoved="OnCanvasPointerMoved">
                        <Canvas.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="新建状态 (Create State)" Click="OnCreateStateClicked" IsVisible="{Binding !IsMakingTransition}" />
                                <MenuItem Header="取消过渡 (Cancel Transition)" Command="{Binding CancelTransitionCommand}" IsVisible="{Binding IsMakingTransition}" />
                            </ContextMenu>
                        </Canvas.ContextMenu>
                        
                        <!-- Pending Transition Line -->
                        <Path Stroke="#55aaff" StrokeThickness="2" StrokeDashArray="3,2"
                              Data="{Binding PendingTransitionLineData}" IsVisible="{Binding IsMakingTransition}" />

                        <!-- Transitions (Lines) -->
                    <ItemsControl ItemsSource="{Binding TransitionLines}" Width="4000" Height="4000" UseLayoutRounding="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="4000" Height="4000" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Canvas ClipToBounds="False" UseLayoutRounding="False">
                                    <Path Stroke="{Binding Color}" StrokeThickness="1.5" Fill="{Binding Color}" 
                                          Data="{Binding LineData}" />
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- States (Boxes) -->
                    <ItemsControl ItemsSource="{Binding States}" Width="4000" Height="4000">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                            <Style Selector="ItemsControl > ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Border Width="160" Height="42" 
                                        Background="{Binding BackgroundColor}"
                                        BorderBrush="#1a1a1a" BorderThickness="1"
                                        CornerRadius="3"
                                        BoxShadow="0 2 6 0 #77000000"
                                        PointerPressed="OnStatePointerPressed"
                                        PointerMoved="OnStatePointerMoved"
                                        PointerReleased="OnStatePointerReleased"
                                        Tapped="OnStateTapped">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="过渡 (Make Transition)" Command="{Binding $parent[Window].DataContext.StartTransitionCommand}" CommandParameter="{Binding}" />
                                            <MenuItem Header="设为默认 (Set as Layer Default State)" Command="{Binding $parent[Window].DataContext.SetAsDefaultStateCommand}" CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="复制 (Copy)" />
                                            <MenuItem Header="删除 (Delete)" Command="{Binding $parent[Window].DataContext.DeleteStateCommand}" CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="400">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
                                            <TextBlock Text="状态信息 (State Info):" FontWeight="Bold" FontSize="10" Foreground="#aaaaaa" Margin="0,5,0,2"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="过渡数量:" FontSize="10" Foreground="#888888"/>
                                                <TextBlock Text="{Binding Transitions.Count}" FontSize="10" Foreground="#55aaff"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ToolTip.Tip>
                                    <Grid>
                                        <!-- Optional gradient overlay to match Unity look -->
                                        <Border CornerRadius="3" Opacity="0.1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                    <GradientStop Offset="0" Color="White"/>
                                                    <GradientStop Offset="1" Color="Transparent"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                   Foreground="#eeeeee" FontSize="11" FontWeight="Normal"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Padding="10,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </ScrollViewer>
            
            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="#383838" Padding="10,5" BorderBrush="#111111" BorderThickness="0,1,0,0" Height="30">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="提示: 悬停以查看条件 (Tip: Hover to view conditions)" Foreground="#666666" FontSize="10" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Rectangle Width="10" Height="10" Fill="#8a5d00" Stroke="#111111" StrokeThickness="1"/>
                            <TextBlock Text="默认 (Default)" Foreground="#888888" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="#3c3c3c" BorderBrush="#111111" BorderThickness="1,0,0,0">
            <Panel>
                <ScrollViewer IsVisible="{Binding SelectedState, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Margin="10, 15" Spacing="20">
                        <!-- Title & Header -->
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border Width="20" Height="20" Background="#383838" CornerRadius="2">
                                <TextBlock Text="■" Foreground="#55aaff" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10"/>
                            </Border>
                            <TextBox Grid.Column="1" Text="{Binding SelectedState.Name}" 
                                     Foreground="#eeeeee" FontSize="13" FontWeight="Bold" Margin="10,0"
                                     Background="Transparent" BorderThickness="0" Padding="0" 
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="?" Foreground="#888888" Cursor="Help"/>
                        </Grid>

                        <Separator Background="#222222" Height="1"/>

                        <!-- Property Fields -->
                        <StackPanel Spacing="8">
                            <!-- Tag Field -->
                            <Grid ColumnDefinitions="120, *">
                                <TextBlock Text="标签 (Tag)" Foreground="#cccccc" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox Grid.Column="1" Text="{Binding SelectedState.Tag}" Background="#282828" BorderBrush="#1a1a1a" Height="24" Padding="5,2" FontSize="11"/>
                            </Grid>

                            <!-- Motion -->
                            <Grid ColumnDefinitions="120, *">
                                <TextBlock Text="动画 (Motion)" Foreground="#cccccc" VerticalAlignment="Center" FontSize="11"/>
                                <Button Grid.Column="1" x:Name="MotionButton" HorizontalAlignment="Stretch" Padding="5,0" Height="26"
                                        Background="#282828" BorderBrush="#1a1a1a" BorderThickness="1">
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft" Opened="OnMotionFlyoutOpened">
                                            <StackPanel Width="320" MaxHeight="400" Spacing="8">
                                                <!-- Search box inside Flyout -->
                                                <TextBox x:Name="MotionSearchBox" Watermark="搜索动画名称... 模糊搜索 (Search Motion Name... Fuzzy Search)" 
                                                         Text="{Binding $parent[Window].DataContext.MotionSearchText, Mode=TwoWay}"
                                                         Height="28" FontSize="11" Background="#1e1e1e" BorderBrush="#333333" 
                                                         Padding="8,2" VerticalContentAlignment="Center"/>
                                                
                                                <ListBox ItemsSource="{Binding $parent[Window].DataContext.FilteredMotions}"
                                                         SelectedItem="{Binding SelectedState.CurrentMotion, Mode=TwoWay}"
                                                         Background="#252525" MaxHeight="340" BorderThickness="0"
                                                         Tapped="OnMotionListBoxTapped">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:CompileBindings="False">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" Padding="2,2"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="{Binding SelectedState.MotionName}" Foreground="#55aaff" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="▼" Foreground="#666666" FontSize="8" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- Speed -->
                            <Grid ColumnDefinitions="120, *">
                                <TextBlock Text="速度 (Speed)" Foreground="#cccccc" VerticalAlignment="Center" FontSize="11"/>
                                <Grid Grid.Column="1" ColumnDefinitions="*, Auto">
                                    <NumericUpDown Value="{Binding SelectedState.Speed}" Height="24" Minimum="0" Maximum="20" 
                                                   Background="#282828" BorderBrush="#1a1a1a" FontSize="11" Padding="5,0"/>
                                </Grid>
                            </Grid>

                            <!-- Toggles -->
                            <Grid ColumnDefinitions="120, *">
                                <TextBlock Text="镜像 (Mirror)" Foreground="#cccccc" VerticalAlignment="Center" FontSize="11"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding SelectedState.Mirror}" MinWidth="0" Padding="0"/>
                            </Grid>

                            <Grid ColumnDefinitions="120, *">
                                <TextBlock Text="足部 IK (Foot IK)" Foreground="#cccccc" VerticalAlignment="Center" FontSize="11"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding SelectedState.IKOnFeet}" MinWidth="0" Padding="0"/>
                            </Grid>

                            <Grid ColumnDefinitions="120, *">
                                <TextBlock Text="写入默认值 (Write Defaults)" Foreground="#cccccc" VerticalAlignment="Center" FontSize="11"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding SelectedState.WriteDefaultValues}" MinWidth="0" Padding="0"/>
                            </Grid>
                        </StackPanel>

                        <Separator Background="#222222" Height="1"/>

                        <!-- Transitions Section -->
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <TextBlock Text="转换 (Transitions)" Foreground="#aaaaaa" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="独卖 (Solo)" Foreground="#888888" FontSize="9" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="静音 (Mute)" Foreground="#888888" FontSize="9" Margin="5,0"/>
                            </Grid>
                            
                            <ListBox ItemsSource="{Binding SelectedState.Transitions}" Background="#313131" BorderThickness="1" BorderBrush="#222222" MaxHeight="400">
                                 <ListBox.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <Border BorderBrush="#1a1a1a" BorderThickness="0,0,0,1" Padding="0,8" Background="#383838">
                                            <StackPanel Spacing="8">
                                                <!-- Transition Header -->
                                                <Grid ColumnDefinitions="*, Auto, Auto" Margin="10,0">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#55aaff" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                                                        <CheckBox IsChecked="{Binding Solo}" IsVisible="{Binding IsNormalTransition}" MinWidth="0" Padding="0" Margin="4,0" ToolTip.Tip="Solo"/>
                                                        <CheckBox IsChecked="{Binding Mute}" IsVisible="{Binding IsNormalTransition}" MinWidth="0" Padding="0" Margin="4,0" ToolTip.Tip="Mute"/>
                                                        <Button Command="{Binding RemoveCommand}" Width="20" Height="20" Padding="0" Background="#444444" BorderThickness="1" BorderBrush="#1a1a1a" IsVisible="{Binding IsNormalTransition}" ToolTip.Tip="删除转换 (Delete Transition)">
                                                             <TextBlock Text="-" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- Conditions belong to this specific transition -->
                                                <ItemsControl ItemsSource="{Binding ConditionList}" Margin="10,0" IsVisible="{Binding IsNormalTransition}">
                                                     <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:CompileBindings="False">
                                                            <Grid ColumnDefinitions="20, 1.5*, 1.2*, 1*" Margin="0,1">
                                                                <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                                 <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[Window].DataContext.ParameterItems}" 
                                                                           SelectedValue="{Binding ParamName}" SelectedValueBinding="{Binding Name}"
                                                                          Height="24" Padding="6,0" FontSize="11" Margin="1" HorizontalAlignment="Stretch"
                                                                          Background="#3c3c3c" BorderThickness="1" BorderBrush="#1a1a1a">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:CompileBindings="False">
                                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableModes}" 
                                                                          SelectedItem="{Binding Mode}" Height="24" Padding="6,0" FontSize="11" Margin="1"
                                                                          Background="#3c3c3c" BorderThickness="1" BorderBrush="#1a1a1a" IsVisible="{Binding HasMode}"
                                                                          HorizontalAlignment="Stretch"/>

                                                                <TextBox Grid.Column="3" Text="{Binding Threshold}" Height="24" Padding="6,-1" FontSize="11" Margin="1"
                                                                         Background="#282828" BorderThickness="1" BorderBrush="#1a1a1a" IsVisible="{Binding HasThreshold}"
                                                                         VerticalContentAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                     </ItemsControl.ItemTemplate>
                                                 </ItemsControl>

                                                 <!-- Condition Controls (+ / -) -->
                                                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,10,0" Spacing="2" IsVisible="{Binding IsNormalTransition}">
                                                     <Button Command="{Binding AddConditionCommand}" Width="22" Height="18" Padding="0" Background="#444444" BorderThickness="1" BorderBrush="#1a1a1a" ToolTip.Tip="添加条件 (Add Condition)">
                                                         <TextBlock Text="+" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                                     </Button>
                                                     <Button Command="{Binding RemoveConditionCommand}" Width="22" Height="18" Padding="0" Background="#444444" BorderThickness="1" BorderBrush="#1a1a1a" ToolTip.Tip="删除选中条件 (Remove Selected Conditions)">
                                                         <TextBlock Text="-" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                                     </Button>
                                                 </StackPanel>
                                             </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                 </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <Button Content="添加行为 (Add Behaviour)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#4f4f4f" Foreground="White" FontSize="11" Height="30" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                
                <TextBlock IsVisible="{Binding SelectedState, Converter={x:Static ObjectConverters.IsNull}}"
                           Text="请选择一个状态以查看属性 (Select a state to view properties)" 
                           Foreground="#666666" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Panel>
        </Border>
    </Grid>
</DockPanel>
</Window>
