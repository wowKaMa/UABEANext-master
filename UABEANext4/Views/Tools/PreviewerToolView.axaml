<UserControl xmlns="https://github.com/avaloniaui"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uaw="using:UABEANext4.AssetWorkspace"
             xmlns:mesh="using:UABEANext4.Controls.MeshPreviewer"
             xmlns:tools="using:UABEANext4.ViewModels.Tools"
             xmlns:toolsv="using:UABEANext4.Views.Tools"
             xmlns:avedit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UABEANext4.Views.Tools.PreviewerToolView"
             x:DataType="tools:PreviewerToolViewModel">
             <UserControl.DataTemplates>
    <toolsv:PreviewerTemplateSelector>
      <DataTemplate x:Key="Image" DataType="tools:PreviewerToolPreviewType">
        <Image Source="{Binding $parent[UserControl].((tools:PreviewerToolViewModel)DataContext).ActiveImage}" Margin="0,0,0,0" Stretch="Uniform" StretchDirection="DownOnly">
          <Image.RenderTransform>
            <ScaleTransform ScaleY="-1" />
            </Image.RenderTransform>

        </Image>

      </DataTemplate>

      <DataTemplate x:Key="Text" DataType="tools:PreviewerToolPreviewType">
        <avedit:TextEditor FontFamily="Cascadia Code,Consolas,Monospace,Courier,DejaVu Sans Mono,Roboto Mono,Menlo" Document="{Binding $parent[UserControl].((tools:PreviewerToolViewModel)DataContext).ActiveDocument}" WordWrap="True" IsReadOnly="True" />
        </DataTemplate>

      <DataTemplate x:Key="Mesh" DataType="tools:PreviewerToolPreviewType">
        <mesh:MeshPreviewerControl ActiveMesh="{Binding $parent[UserControl].((tools:PreviewerToolViewModel)DataContext).ActiveMesh}" />
        </DataTemplate>

    </toolsv:PreviewerTemplateSelector>

  </UserControl.DataTemplates>

  <Grid>
    <ContentControl Content="{Binding ActivePreviewType}" Name="contentControl" />
    </Grid>

</UserControl>
<!-- <UserControl xmlns="https://github.com/avaloniaui" -->
<!-- 根节点：声明这是一个 Avalonia 的 UserControl，并指定默认 XAML 命名空间。 -->

<!-- xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" -->
<!-- 引入 x: 命名空间，提供 x:Class、x:Name 等 XAML 语言功能。 -->

<!-- xmlns:d="http://schemas.microsoft.com/expression/blend/2008" -->
<!-- 设计时命名空间，仅在设计器（如 Visual Studio / Blend）中使用的属性。 -->

<!-- xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" -->
<!-- 兼容性命名空间，用于处理不同 XAML 版本或设计时属性。 -->

<!-- xmlns:uaw="using:UABEANext4.AssetWorkspace" -->
<!-- 引用项目中 UABEANext4.AssetWorkspace 命名空间，以便在 XAML 中使用其中的类型（例如 WorkspaceItem 等）。 -->

<!-- xmlns:mesh="using:UABEANext4.Controls.MeshPreviewer" -->
<!-- 引用项目中 MeshPreviewer 控件所在的命名空间，用于在模板中使用 MeshPreviewerControl。 -->

<!-- xmlns:tools="using:UABEANext4.ViewModels.Tools" -->
<!-- 引用 ViewModels.Tools 命名空间，以便在 x:DataType 和绑定路径中使用 PreviewerToolViewModel 等类型。 -->

<!-- xmlns:toolsv="using:UABEANext4.Views.Tools" -->
<!-- 引用 Views.Tools 命名空间，以便在 DataTemplates 中使用自定义的 PreviewerTemplateSelector。 -->

<!-- xmlns:avedit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit" -->
<!-- 引入 AvaloniaEdit 编辑器控件的 CLR 命名空间，用于在模板中使用 TextEditor。 -->

<!-- mc:Ignorable="d" -->
<!-- 指示解析器忽略以 d: 前缀开头的属性（设计时属性），避免运行时错误。 -->

<!-- d:DesignWidth="800" -->
<!-- 设计器中显示的默认宽度（仅设计时参考）。 -->

<!-- d:DesignHeight="450" -->
<!-- 设计器中显示的默认高度（仅设计时参考）。 -->

<!-- x:Class="UABEANext4.Views.Tools.PreviewerToolView" -->
<!-- 指定此 XAML 对应的后台 C# 部分类（partial class），用于代码隐藏文件关联。 -->

<!-- x:DataType="tools:PreviewerToolViewModel" -->
<!-- 指定此视图的数据上下文类型为 PreviewerToolViewModel，以便编译时绑定检查和 IntelliSense。 -->

<!-- <UserControl.DataTemplates> -->
<!-- 开始定义 UserControl 级别的数据模板集合（用于根据类型选择不同的预览模板）。 -->

<!-- <toolsv:PreviewerTemplateSelector> -->
<!-- 使用自定义的 PreviewerTemplateSelector 作为模板选择器的容器（该类型在 Views.Tools 命名空间中）。 -->

<!-- <DataTemplate x:Key="Image" DataType="tools:PreviewerToolPreviewType"> -->
<!-- 定义一个键为 "Image" 的 DataTemplate，用于图像预览类型。DataType 指示模板适用的数据类型。 -->

<!-- <Image Source="{Binding $parent[UserControl].((tools:PreviewerToolViewModel)DataContext).ActiveImage}" Margin="0,0,0,0" Stretch="Uniform" StretchDirection="DownOnly"> -->
<!-- 在 Image 模板中放置一个 Image 控件。Source 绑定到父 UserControl 的 DataContext（PreviewerToolViewModel）中的 ActiveImage 属性。Stretch 和 StretchDirection 控制图像缩放行为。 -->

<!-- <Image.RenderTransform> -->
<!-- 开始定义 Image 的渲染变换（RenderTransform）。 -->

<!-- <ScaleTransform ScaleY="-1" /> -->
<!-- 使用 ScaleTransform 将图像在 Y 轴翻转（ScaleY=-1），常用于坐标系或纹理方向调整。 -->

<!-- </Image.RenderTransform> -->
<!-- 结束 Image 的渲染变换定义。 -->

<!-- </Image> -->
<!-- 结束 Image 控件定义（图像模板主体）。 -->

<!-- </DataTemplate> -->
<!-- 结束 Image 类型的数据模板定义。 -->

<!-- <DataTemplate x:Key="Text" DataType="tools:PreviewerToolPreviewType"> -->
<!-- 定义一个键为 "Text" 的 DataTemplate，用于文本预览类型。 -->

<!-- <avedit:TextEditor FontFamily="Cascadia Code,Consolas,Monospace,Courier,DejaVu Sans Mono,Roboto Mono,Menlo" Document="{Binding $parent[UserControl].((tools:PreviewerToolViewModel)DataContext).ActiveDocument}" WordWrap="True" IsReadOnly="True" /> -->
<!-- 在 Text 模板中使用 AvaloniaEdit 的 TextEditor。 -->
<!-- FontFamily 指定优先字体列表。Document 绑定到父 UserControl 的 DataContext 中的 ActiveDocument（通常是 AvalonEdit 文档对象）。 -->
<!-- WordWrap 启用自动换行，IsReadOnly 设置为只读以防编辑。 -->

<!-- </DataTemplate> -->
<!-- 结束 Text 类型的数据模板定义。 -->

<!-- <DataTemplate x:Key="Mesh" DataType="tools:PreviewerToolPreviewType"> -->
<!-- 定义一个键为 "Mesh" 的 DataTemplate，用于网格/模型预览类型。 -->

<!-- <mesh:MeshPreviewerControl ActiveMesh="{Binding $parent[UserControl].((tools:PreviewerToolViewModel)DataContext).ActiveMesh}" /> -->
<!-- 在 Mesh 模板中使用自定义的 MeshPreviewerControl，并将其 ActiveMesh 属性绑定到父 UserControl 的 DataContext 中的 ActiveMesh。 -->
<!-- 该控件负责渲染 3D/网格数据（实现位于 UABEANext4.Controls.MeshPreviewer 命名空间）。 -->

<!-- </DataTemplate> -->
<!-- 结束 Mesh 类型的数据模板定义。 -->

<!-- </toolsv:PreviewerTemplateSelector> -->
<!-- 结束 PreviewerTemplateSelector 容器。该选择器会根据绑定的 ActivePreviewType 或其他逻辑选择上面定义的模板。 -->

<!-- </UserControl.DataTemplates> -->
<!-- 结束 UserControl 的数据模板集合定义。 -->

<!-- <Grid> -->
<!-- 主布局容器：一个 Grid（此处未定义行列，默认单格）。 -->

<!-- <ContentControl Content="{Binding ActivePreviewType}" Name="contentControl" /> -->
<!-- 使用 ContentControl 显示当前的预览内容。Content 绑定到 ViewModel 的 ActivePreviewType（通常是一个指示当前预览类型或包装了模板选择信息的对象）。 -->
<!-- 结合上面定义的 PreviewerTemplateSelector，ContentControl 会根据 ActivePreviewType 选择并显示对应的 DataTemplate（Image/Text/Mesh）。 -->

<!-- </Grid> -->
<!-- 结束 Grid 布局容器。 -->

<!-- </UserControl> -->
<!-- 结束 UserControl 根节点。 -->
