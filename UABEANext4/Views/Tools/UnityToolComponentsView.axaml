<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:um="using:UABEANext4.Controls"
    xmlns:tools="using:UABEANext4.ViewModels.Tools"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="450"
    x:Class="UABEANext4.Views.Tools.UnityToolComponentsView"
    x:DataType="tools:UnityToolComponentsViewModel">
    <Grid RowDefinitions="*,Auto">
    <um:AssetDataTreeView
            Grid.Row="0"
            Name="ComponentTreeView"
            Workspace="{Binding Workspace}"
            ActiveAssets="{Binding ActiveAssets}"
            Margin="2" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="5" HorizontalAlignment="Right">
        <Button Content="强制刷新 (Refresh)" 
                    Command="{Binding RefreshCommand}" 
                    ToolTip.Tip="重新加载并应用汉化映射" />
            </StackPanel>

    </Grid>

</UserControl>