<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <ListBox Classes="RadioButtonListBox" Width="100">
        <ListBoxItem>苹果 (Apple)</ListBoxItem>
        <ListBoxItem>香蕉 (Banana)</ListBoxItem>
        <ListBoxItem>胡萝卜 (Carrot)</ListBoxItem>
      </ListBox>
    </Border>
  </Design.PreviewWith>

  <Style Selector="ListBox.RadioButtonListBox">
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.RadioButtonListBox ListBoxItem">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="Transparent">
            <RadioButton Content="{TemplateBinding ContentPresenter.Content}"
                         VerticalAlignment="Center"
                         IsChecked="{TemplateBinding IsSelected, Mode=TwoWay}"
                         ToolTip.Tip="{TemplateBinding Tag}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</Styles>
<!-- <Styles xmlns="https://github.com/avaloniaui" -->
<!-- 声明 Styles 根节点并指定 Avalonia 的 XAML 命名空间。 -->

<!-- xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"> -->
<!-- 引入 x: 命名空间，提供 x:Type 等 XAML 语言功能。 -->

