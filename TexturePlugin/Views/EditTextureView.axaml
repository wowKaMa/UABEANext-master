<!-- 各向异性过滤输入框：放在第六行第二列。 -->

<!-- Text="{Binding FilteringString}" -->
<!-- Text 绑定到 ViewModel 的 FilteringString。 -->

<!-- Watermark="{Binding FilteringWatermark}" /> -->
<!-- Watermark 绑定到 ViewModel 的 FilteringWatermark。 -->

<!-- <TextBox Grid.Column="1" Grid.Row="6" -->
<!-- Mipmap 偏移输入框：放在第七行第二列。 -->

<!-- Text="{Binding MipBiasString}" -->
<!-- Text 绑定到 ViewModel 的 MipBiasString。 -->

<!-- Watermark="{Binding MipBiasWatermark}" /> -->
<!-- Watermark 绑定到 ViewModel 的 MipBiasWatermark。 -->

<!-- <ComboBox Grid.Column="1" Grid.Row="7" -->
<!-- Wrap mode U 下拉：放在第八行第二列。 -->

<!-- SelectedItem="{Binding WrapModeU}" -->
<!-- SelectedItem 绑定到 ViewModel 的 WrapModeU。 -->

<!-- ItemsSource="{Binding WrapModes}" -->
<!-- ItemsSource 绑定到 ViewModel 的 WrapModes（可选包装模式集合）。 -->

